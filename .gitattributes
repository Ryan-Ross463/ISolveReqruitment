# Auto detect text files
* text=auto

# Java files
*.java text eol=lf

# Maven
*.xml text eol=lf
*.properties text eol=lf

# JavaScript / TypeScript
*.js text eol=lf
*.jsx text eol=lf
*.ts text eol=lf
*.tsx text eol=lf

# React
*.css text eol=lf
*.html text eol=lf

# Docker
Dockerfile text eol=lf
*.yml text eol=lf
*.yaml text eol=lf

# Shell scripts
*.sh text eol=lf

# Windows scripts
*.bat text eol=crlf
*.cmd text eol=crlf